# Site originals and captures that stay on the collecting machine:
# CSS/font/icon/image downloads, page screenshots (contain user content), per-page style dumps
reference/
screenshots/*
!screenshots/tokens-preview.png
data/

# Throwaway browser profiles created by the crawler
tools/*profile*/
tools/edge-profile/
tools/q[0-9]-*/
tools/DevToolsActivePort

# Local-only helper scripts
tools/_local/

# Credentials
*.token
token
token.txt
.env
.env.*
.git-credentials

# Logs and scratch output
*.log
tools/probe-*.js
tools/probe*.png
data/_*.png
*_backup*

# Dependencies
node_modules/
package-lock.json

# Editors and OS
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
